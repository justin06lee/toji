# Toji configuration. Copy to .env (or .env.local) and adjust.
# Inference is zero-config: the embedded yagami engine drives whichever coding-agent
# CLIs you're already signed into (Claude Code, Codex, opencode, Gemini CLI, …).
# A custom OpenAI-compatible endpoint can be configured in Toji's Settings UI.

# What powers inference:
#   yagami  -> the embedded yagami engine (default; no keys, nothing to configure)
#   local   -> the custom endpoint configured in Settings
#   off     -> disable the model; Toji uses deterministic demo/heuristic output
TOJI_AGENT=yagami

# Optional yagami model override, e.g. sonnet, haiku, codex:gpt-5.6-sol.
# Empty = the engine's default (also configurable in Settings).
TOJI_AGENT_MODEL=

# Max wall-clock per model call, in ms.
TOJI_AGENT_TIMEOUT_MS=120000

# Optional production search provider. Default uses the DuckDuckGo HTML endpoint.
# Set SEARCH_PROVIDER=brave and supply your OWN key to use Brave search.
SEARCH_PROVIDER=duckduckgo
BRAVE_SEARCH_API_KEY=

# Server / browser controls
PORT=8788
MAX_AGENT_TABS=8
MAX_SPECULATIVE_TABS=2
MAX_CONCURRENT_TABS=3
MAX_SEARCH_QUERIES=4
SESSION_HISTORY_LIMIT=24
AGENT_BROWSER_HEADLESS=true
AGENT_REQUEST_TIMEOUT_MS=18000
ENABLE_VISUAL_ANALYSIS=true
SOURCE_CACHE_TTL_HOURS=72
TOJI_DATA_DIR=.toji-data
DEMO_MODE_ENABLED=true

# Frontend controls
VITE_AGENT_SERVER_URL=http://127.0.0.1:8788

# Optional custom User-Agent for Playwright research tabs
AGENT_USER_AGENT=
