# Toji configuration. Copy to .env (or .env.local) and adjust.
# Toji has NO API keys: inference is done by a local CLI coding agent you already
# have installed and authenticated (Claude Code, Codex, opencode, …).

# Which CLI coding agent to drive. Built-in presets:
#   claude    -> claude -p --dangerously-skip-permissions          (default)
#   codex     -> codex exec --dangerously-bypass-approvals-and-sandbox -
#   opencode  -> opencode run
#   off       -> disable the agent; Toji uses deterministic demo/heuristic output
TOJI_AGENT=claude

# Full command override. Wins over TOJI_AGENT. Useful to pin an absolute binary
# path (a packaged GUI app has a minimal PATH) or pass extra flags. The prompt is
# piped to the command on stdin.
#   TOJI_AGENT_CMD=/opt/homebrew/bin/claude -p --dangerously-skip-permissions
TOJI_AGENT_CMD=

# Max wall-clock per agent call, in ms. CLI agents are slower than a hosted API.
TOJI_AGENT_TIMEOUT_MS=120000

# Optional production search provider. Default uses the DuckDuckGo HTML endpoint.
# Set SEARCH_PROVIDER=brave and supply your OWN key to use Brave search.
SEARCH_PROVIDER=duckduckgo
BRAVE_SEARCH_API_KEY=

# Server / browser controls
PORT=8787
MAX_AGENT_TABS=8
MAX_SPECULATIVE_TABS=2
MAX_CONCURRENT_TABS=3
MAX_SEARCH_QUERIES=4
SESSION_HISTORY_LIMIT=24
AGENT_BROWSER_HEADLESS=true
AGENT_REQUEST_TIMEOUT_MS=18000
ENABLE_VISUAL_ANALYSIS=true
SOURCE_CACHE_TTL_HOURS=72
TOJI_DATA_DIR=.toji-data
DEMO_MODE_ENABLED=true

# Frontend controls
VITE_AGENT_SERVER_URL=http://127.0.0.1:8787

# Optional custom User-Agent for Playwright research tabs
AGENT_USER_AGENT=
