browser.jar:
% content toji %content/toji/ contentaccessible=no
  content/toji/toji.css                  (content/toji.css)
  content/toji/fonts/                    (content/fonts/*)
  content/toji/profiles/                 (content/profiles/*.svg)
# Toji's pages, built by `bun run build:pages` (gecko/build.ts).
  content/toji/pages/                    (content/pages/*.html)
  content/toji/pages/assets/             (content/pages/assets/*)
