# Toji's own layer on top of Firefox. browser/moz.build exports
# DIST_SUBDIR = "browser", so ".." is the GRE directory
# (Toji.app/Contents/Resources on macOS).

# Locked prefs that strip Mozilla's services, read by autoconfig
# (general.config.filename in the branding prefs).
FINAL_TARGET_FILES[".."] += ["toji.cfg"]

# Enterprise policies: the second lock on the same services.
FINAL_TARGET_FILES[".."].distribution += ["distribution/policies.json"]
