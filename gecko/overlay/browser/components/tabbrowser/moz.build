# Toji (gecko/overlay): the tab model, without Firefox's all-tabs menu, tab
# previews, group editor, tab notes and AI grouping.

with Files("**"):
    BUG_COMPONENT = ("Firefox", "Tabbed Browser")

JAR_MANIFESTS += ["jar.mn"]

MOZ_SRC_FILES += [
    "AsyncTabSwitcher.sys.mjs",
    "GroupsList.sys.mjs",
    "NewTabPagePreloading.sys.mjs",
    "OpenInTabsUtils.sys.mjs",
    "TabMetrics.sys.mjs",
    "TabUnloader.sys.mjs",
]
