# Toji (gecko/overlay): downloads' backend (the Save dialog, the Dock badge,
# Finder progress), without Firefox's panel and about:downloads.

MOZ_SRC_FILES += [
    "DownloadsCommon.sys.mjs",
    "DownloadSpamProtection.sys.mjs",
    "DownloadsTaskbar.sys.mjs",
    "DownloadsViewableInternally.sys.mjs",
    "DownloadsViewUI.sys.mjs",
]

toolkit = CONFIG["MOZ_WIDGET_TOOLKIT"]
if toolkit == "cocoa":
    MOZ_SRC_FILES += ["DownloadsMacFinderProgress.sys.mjs"]
