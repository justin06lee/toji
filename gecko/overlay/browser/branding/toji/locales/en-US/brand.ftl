## Toji brand
##
## Toji is built on Mozilla's Gecko engine but carries none of Mozilla's
## trademarks, so every brand term resolves to Toji.

-brand-shorter-name = Toji
-brand-short-name = Toji
-brand-shortcut-name = Toji
-brand-full-name = Toji
# This brand name can be used in messages where the product name needs to
# remain unchanged across different versions.
-brand-product-name = Toji
-vendor-short-name = Toji
trademarkInfo = { " " }
