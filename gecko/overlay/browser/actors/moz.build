# Toji (gecko/overlay): the actors behind the engine's behaviour in pages —
# prompts, permissions, links and favicons, media, crashes, the context menu.
# The ones behind Firefox's pages and panels are deleted.

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")

