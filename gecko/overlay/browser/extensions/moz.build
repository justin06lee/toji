# Toji (gecko/overlay): the built-in add-ons that make sites work. The new-tab
# page, form autofill, the VPN activator and search-hijack telemetry are gone.

DIRS += [
    "webcompat",
    "pictureinpicture",
]

JAR_MANIFESTS += ["jar.mn"]
